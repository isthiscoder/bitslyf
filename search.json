---
layout: null
permalink: /search.json
---
{%- comment -%} Everything the header search looks through: title, date, tags and type of every entry. {%- endcomment -%}
[
{%- assign docs = site.documents | sort: "date" | reverse -%}
{%- for d in docs -%}
  {%- capture type %}{% include layer-name.html layer=d.layer %}{% endcapture -%}
  {
    "title": {{ d.claim | default: d.title | jsonify }},
    "type": {{ type | strip | jsonify }},
    "date": {{ d.date | date: "%Y-%m-%d" | jsonify }},
    "tags": {% if d.tags %}{{ d.tags | jsonify }}{% else %}[]{% endif %},
    "summary": {{ d.summary | default: "" | jsonify }},
    "result": {{ d.result | default: "" | jsonify }},
    "url": {{ d.url | relative_url | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
